ndles day-to-day operations."]}, "source_analysis_task_id": 631, "marks": []}, "result": {"decision": "trade", "allocation": {"side": "NO", "score": 0.055379563258181656, "fraction_of_gross": 0.055379563258181656, "dollars": 5.537956325818166, "shares": 8.265606456445024, "cost": 0.6699999999999999}, "wealth": 100.0, "locked_value": 0.0}}}
