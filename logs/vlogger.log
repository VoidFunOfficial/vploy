interest constraints."]}, "source_analysis_task_id": 631, "marks": []}, "result": {"decision": "trade", "allocation": {"side": "YES", "score": 0.009850304779693807, "fraction_of_gross": 0.009850304779693807, "dollars": 0.9850304779693807, "shares": 30.308630091365558, "cost": 0.0325}, "wealth": 100.0, "locked_value": 0.0}}}
