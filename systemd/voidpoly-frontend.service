[Unit]
Description=VoidPoly Frontend Build Service (Deprecated - Use Nginx)
Documentation=https://github.com/voidpoly/voidpoly
After=network.target

[Service]
Type=oneshot
User=%USER%
Group=%USER%
WorkingDirectory=%WORKDIR%/frontend

# 环境变量
Environment="NODE_ENV=production"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# 构建命令（仅构建，不运行开发服务器）
ExecStart=%NPM% run build
RemainAfterExit=yes

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voidpoly-frontend-build

[Install]
WantedBy=multi-user.target

