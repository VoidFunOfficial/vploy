[Unit]
Description=VoidPoly Huey Task Worker
Documentation=https://github.com/voidpoly/voidpoly
After=network.target voidpoly-api.service

[Service]
Type=simple
User=%USER%
Group=%USER%
WorkingDirectory=%WORKDIR%

# 环境变量
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=%CONDA_PATH%"

# 启动命令
ExecStart=%PYTHON% /home/ubuntu/vploy/run_task_worker.py

# 重启策略
Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voidpoly-worker

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 优雅关闭
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target

