[Unit]
Description=VoidPoly API Server
Documentation=https://github.com/voidpoly/voidpoly
After=network.target

[Service]
Type=simple
User=%USER%
Group=%USER%
WorkingDirectory=%WORKDIR%

# 环境变量
Environment="PYTHONUNBUFFERED=1"
Environment="FLASK_ENV=production"
Environment="PATH=%CONDA_PATH%"

# 启动命令
ExecStart=%PYTHON% %WORKDIR%/run_api_server.py

# 重启策略
Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voidpoly-api

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 优雅关闭
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target

